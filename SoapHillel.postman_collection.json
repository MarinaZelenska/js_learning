{
	"info": {
		"_postman_id": "b14c37f3-8722-4a7c-a859-0efc86cb28bc",
		"name": "SoapHillel",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "38593287"
	},
	"item": [
		{
			"name": "IsValidISBN10",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const responseData = xml2Json(pm.response.text())",
							"",
							"pm.test(\"Response status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Content type is text/xml\", function () {",
							"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/xml\");",
							"});",
							"",
							"pm.test(\"ValidISBN10Result should be true\", function () {",
							"    actualResult = responseData['soap:Envelope']['soap:Body']['m:IsValidISBN10Response']['m:IsValidISBN10Result']",
							"    pm.expect(actualResult).to.be.eql(\"true\")",
							"});",
							"",
							"pm.test(\"Response has correct encoding\", function () {",
							"    var responseBody = pm.response.text();",
							"    pm.expect(responseBody).to.match(/^<\\?xml version=\"1.0\" encoding=\"utf-8\"\\?>/);",
							"});",
							"",
							"pm.test(\"Soap envelope is present in the response\", function () {",
							"    pm.expect(responseData).to.have.property('soap:Envelope');",
							"});",
							"",
							"pm.test(\"Body contains IsValidISBN10Response and IsValidISBN10Result\", function () {",
							"    pm.expect(responseData).to.have.property('soap:Envelope');",
							"    pm.expect(responseData['soap:Envelope']).to.have.property('soap:Body');",
							"    pm.expect(responseData['soap:Envelope']['soap:Body']).to.have.property('m:IsValidISBN10Response');",
							"    pm.expect(responseData['soap:Envelope']['soap:Body']['m:IsValidISBN10Response']).to.have.property('m:IsValidISBN10Result');",
							"});",
							"",
							"pm.test(\"Response time should be less than 400 mlsec\", function () {",
							"  pm.expect(pm.response.responseTime).to.be.below(400);",
							"});",
							"",
							"",
							"pm.test(\"No SOAP Fault\", function () {",
							"    pm.expect(pm.response.text()).to.not.include('<soap:Fault>');",
							"}); ",
							"",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "text/xml; charset=utf-8",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN10 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>0-19-852663-6</sISBN>\n    </IsValidISBN10>\n  </soap:Body>\n</soap:Envelope>",
					"options": {
						"raw": {
							"language": "xml"
						}
					}
				},
				"url": {
					"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
					"protocol": "http",
					"host": [
						"webservices",
						"daehosting",
						"com"
					],
					"path": [
						"services",
						"isbnservice.wso"
					]
				}
			},
			"response": []
